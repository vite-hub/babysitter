# Copy to .env and fill in. docker compose reads it; never commit it.

## Required

# GitHub App ID, from the App's settings page.
VITEHUB_GITHUB_APP_ID=
# App private key (PEM). Put it on one line with \n for the line breaks:
#   awk 'NF {printf "%s\\n", $0}' your-app.private-key.pem
VITEHUB_GITHUB_PRIVATE_KEY=
# Same secret you set on the App's webhook. Deliveries without a valid signature are rejected.
VITEHUB_GITHUB_WEBHOOK_SECRET=
# Repositories to watch, comma-separated owner/name. The App must be installed on each.
BABYSITTER_REPOS=

## Optional

# Logins whose PRs get repaired and merged. Unset, the worker takes PRs from the repositories'
# owners, members and collaborators, and ignores the two lists below.
# BABYSITTER_MAINTAINERS=
# Outside contributors whose PRs get repaired but merge only after a maintainer approves. Needs maintainers.
# BABYSITTER_CONTRIBUTORS=
# Bots whose PRs get worked, as name or name[bot] (default renovate,dependabot). Needs maintainers.
# BABYSITTER_BOT_AUTHORS=
# Check names your automated reviewer posts, for example pullfrog,pullfrog-approval (default none).
# BABYSITTER_REVIEW_CHECKS=
# Required checks to merge past when they fail the same way on the base branch, as JSON.
# BABYSITTER_BYPASS_INHERITED_CHECKS={"your-org/your-repo":["ci"]}

# Public origin of this host. PR activity then links to it. Read at build time.
# BABYSITTER_PUBLIC_URL=https://babysitter.example.com
# Codex model and reasoning effort for repair passes (default gpt-6.1-sol, medium).
# BABYSITTER_MODEL=
# BABYSITTER_REASONING_EFFORT=
# PRs worked on at once (default 16), and model passes at once (default the same). The memory
# guard admits fewer when the container is tight.
# BABYSITTER_MAX_OWNERS=
# BABYSITTER_MODEL_CONCURRENCY=
# Input-token budgets per hour and per day. 0 pauses new passes; empty means no limit.
# BABYSITTER_HOURLY_INPUT_TOKENS=
# BABYSITTER_DAILY_INPUT_TOKENS=
# Pin installations instead of discovering them: an owner-to-ID JSON map, or one ID with its owner.
# VITEHUB_GITHUB_APP_INSTALLATIONS={"your-org":12345678}
# VITEHUB_GITHUB_INSTALLATION_ID=
# VITEHUB_GITHUB_APP_OWNER=
# Read the key from a file instead, for example one mounted into /data.
# VITEHUB_GITHUB_PRIVATE_KEY_PATH=/data/github-app.pem
# Public keys of the ViteHub Console and CLI callers that may read this host, one variable each.
# VITEHUB_CONSOLE_KEY_CONSOLE=
# Host port that compose publishes (default 3000).
# BABYSITTER_PORT=
# PostHog export of Agent events and errors.
# POSTHOG_API_KEY=
# An OpenAI-compatible proxy for Codex, with its key.
# OPENAI_BASE_URL=
# CLIPROXY_API_KEY=
