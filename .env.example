# Copy to .env and fill in. docker compose reads it; never commit it.

## Required

# GitHub App ID, from the App's settings page.
GITHUB_APP_ID=
# App private key (PEM). Put it on one line with \n for the line breaks:
#   awk 'NF {printf "%s\\n", $0}' your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=
# Same secret you set on the App's webhook. Deliveries without a valid signature are rejected.
GITHUB_WEBHOOK_SECRET=
# Repositories to watch, comma-separated owner/name. The App must be installed on each.
BABYSITTER_REPOS=
# Logins whose PRs get repaired and merged, and who approve outside contributors' PRs.
BABYSITTER_MAINTAINERS=

## Optional

# Public origin of this host. PR activity then links to the Console. Read at build time.
# BABYSITTER_PUBLIC_URL=https://babysitter.example.com
# Codex model and reasoning effort for repair passes (default gpt-6-astra, xhigh).
# BABYSITTER_MODEL=
# BABYSITTER_REASONING_EFFORT=
# Outside contributors whose PRs get repaired but merge only after a maintainer approves (default OrlS15).
# BABYSITTER_CONTRIBUTORS=
# PRs worked on at once (default 16). The memory guard admits fewer when the container is tight.
# BABYSITTER_MAX_OWNERS=
# Input-token budgets per hour and per day. 0 pauses new passes; empty means no limit.
# BABYSITTER_HOURLY_INPUT_TOKENS=
# BABYSITTER_DAILY_INPUT_TOKENS=
# Pin installations instead of discovering them: an owner-to-ID JSON map, or one ID with its owner.
# GITHUB_APP_INSTALLATIONS={"your-org":12345678}
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_OWNER=
# Read the key from a file instead, for example one mounted into /data.
# GITHUB_APP_PRIVATE_KEY_PATH=/data/github-app.pem
# Host port that compose publishes (default 3000).
# BABYSITTER_PORT=
# PostHog export of lifecycle events, exceptions and AI traces.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

## Slimbook only (vite-hub's own host). Leave unset in a fork.

# Codex through the CLIProxy model proxy, configured in the host's Codex config.
# OPENAI_BASE_URL=
# CLIPROXY_API_KEY=
# Heavy-command gate wrapper for worker node processes, and its slot count.
# BABYSITTER_WORKER_BIN=
# BABYSITTER_HEAVY_SLOTS=
# Remote Box fleet over SSH.
# BABYSITTER_FLEET_HOSTS=
# BABYSITTER_FLEET_LOCAL_SLOTS=
# BABYSITTER_FLEET_MEMORY_PER_SLOT_BYTES=
# Model concurrency cap shared with the proxy accounts.
# BABYSITTER_MODEL_CONCURRENCY=
# GitHub API cache proxy for agent subprocesses.
# GHX_BASE_URL=
