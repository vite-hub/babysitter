# Optional structured telemetry. When set, ViteHub's built-in evlog capability
# sends sanitized lifecycle events, exceptions, and AI traces to PostHog.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NODE_ENV=production


# Optional GitHub API proxy used by agent subprocesses.
GHX_BASE_URL=https://ghx.onmax.me
