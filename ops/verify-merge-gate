#!/usr/bin/env bash
set -euo pipefail

release_conf=/etc/systemd/system/babysitter-vitehub.service.d/release.conf
release_root="$(sed -n 's#^ExecStart=/usr/bin/node \(/home/workspace/babysitter-release-[^ ]*\)/\.output/server/index\.mjs$#\1#p' "$release_conf")"

if [ -z "$release_root" ] || [ ! -d "$release_root/.output/server" ]; then
  echo "Babysitter release path is missing or invalid." >&2
  exit 1
fi

if [ ! -x "$release_root/node_modules/.bin/vitehub-drain" ]; then
  echo "Babysitter release lacks the ViteHub drain helper: $release_root" >&2
  exit 1
fi

if ! grep -R -q -F 'Pullfrog is review evidence, not an optional check' "$release_root/.output/server"; then
  echo "Babysitter release lacks the Pullfrog merge gate: $release_root" >&2
  exit 1
fi

if ! grep -R -q -F 'A terminal Pullfrog quota, error, or unavailable result is non-blocking when it leaves no actionable feedback' "$release_root/.output/server"; then
  echo "Babysitter release lacks terminal Pullfrog recovery: $release_root" >&2
  exit 1
fi

if ! grep -R -q -F 'Startup, owner completion, and 2m repair scan' "$release_root/.output/server"; then
  echo "Babysitter release lacks the bounded discovery cadence: $release_root" >&2
  exit 1
fi
