+async function removeSessionMemoryGroup(path) {
+  for (const entry of await readdir(path, { withFileTypes: true })) {
+    if (entry.isDirectory()) await removeSessionMemoryGroup(join(path, entry.name));
+  }
+  await rmdir(path);
+}
