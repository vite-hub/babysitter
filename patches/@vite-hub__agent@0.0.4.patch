@@ -0,0 +1,107 @@
+import { createHash, randomUUID } from "node:crypto";
+
+const outboxPrefix = "status-outbox:v1:";
+const sentPrefix = "status-sent:v1:";
+const workerPrefix = "worker-blocker:v1:";
+const digest = value => createHash("sha256").update(JSON.stringify(value)).digest("hex");
+const targetKey = snapshot => `${snapshot.repository}#${snapshot.number}`;
+
+// Persist with the result transaction. Publishing must never depend on a model tool call.
+export async function enqueueStatusResult(inbox, tx, snapshot, claim = {}) {
+  if (!inbox.activityAuthors.size || !snapshot.lastResult?.trim()) return;
+  const head = snapshot.pr?.head?.sha;
+  if (!head || claim.snapshot && claim.snapshot.pr?.head?.sha !== head && claim.resultHead !== head) return;
+  const key = targetKey(snapshot);
+  const contentKey = digest([head, snapshot.generation, snapshot.status, snapshot.lastResult]);
+  const sent = await inbox.metaIn(tx, `${sentPrefix}${key}`);
+  const pending = await inbox.metaIn(tx, `${outboxPrefix}${key}`);
+  if (sent?.contentKey === contentKey || pending?.contentKey === contentKey) return;
+  const now = inbox.clock();
+  await inbox.setMetaIn(tx, `${outboxPrefix}${key}`, {
+    version: randomUUID(), contentKey, repository: snapshot.repository, number: snapshot.number,
+    head, generation: snapshot.generation, text: snapshot.lastResult, attempts: 0, nextAt: now,
+    activity: {
+      runId: claim.runId ?? `saved:${key}:${snapshot.generation}:${head}`,
+      status: snapshot.status === "ready" ? "failed" : "completed",
+      startedAt: claim.startedAt ? new Date(claim.startedAt).toISOString() : undefined,
+      updatedAt: new Date(now).toISOString(), links: claim.activity?.links ?? [], tasks: [],
+      summary: snapshot.lastResult
+    }
+  });
+}
+
+export function isWorkerBlocker(snapshot) {
+  if (snapshot.wait?.kind !== "external" || snapshot.wait.wake) return false;
+  const text = `${snapshot.wait.reason}\n${snapshot.lastResult ?? ""}`;
+  return /MCP tool call requires approval|approval policy is never|read.only[^\n]{0,80}\.git|\.git[^\n]{0,80}read.only|writable (?:\.git|Git (?:metadata|checkout))|restore frozen-lockfile dependency installation/i.test(text);
+}
+
+// Uses the existing managed GitHub activity publisher, including its restart-safe comment lookup.
+export function createBabysitterStatusRecovery({ inbox, revision, publish, event = () => {}, error = () => {} }) {
+  let flushing;
+  let initialized = false;
+  async function updatePending(key, observed, update) {
+    return inbox.transaction(async tx => {
+      const current = await inbox.metaIn(tx, key);
+      if (current?.version !== observed.version) return false;
+      await update(tx, current);
+      return true;
+    });
+  }
+  async function flushPending() {
+    const now = inbox.clock();
+    const entries = (await inbox.metaEntries(outboxPrefix)).filter(([, value]) => value?.nextAt <= now).slice(0, 5);
+    for (const [key, pending] of entries) {
+      try {
+        const snapshot = await inbox.get(pending.repository, pending.number);
+        if (!snapshot || snapshot.pr?.head?.sha !== pending.head) {
+          await updatePending(key, pending, tx => tx.execute(`DELETE FROM ${inbox.tables.meta} WHERE scope=? AND key=?`, [inbox.scope, key]));
+          continue;
+        }
+        await publish(pending);
+        await updatePending(key, pending, async tx => {
+          await inbox.setMetaIn(tx, `${sentPrefix}${targetKey(pending)}`, { contentKey: pending.contentKey, head: pending.head, deliveredAt: inbox.clock() });
+          await tx.execute(`DELETE FROM ${inbox.tables.meta} WHERE scope=? AND key=?`, [inbox.scope, key]);
+        });
+        event("babysitter.status.delivered", { repository: pending.repository, pull_request: pending.number });
+      } catch (failure) {
+        await updatePending(key, pending, async (tx, current) => {
+          const attempts = current.attempts + 1;
+          await inbox.setMetaIn(tx, key, { ...current, attempts, nextAt: inbox.clock() + Math.min(900000, 60000 * 2 ** Math.min(attempts - 1, 4)), lastError: String(failure).slice(0, 1000) });
+        });
+        error("babysitter.status.delivery.failed", failure, { repository: pending.repository, pull_request: pending.number });
+      }
+    }
+  }
+  return {
+    async flush() {
+      if (!publish) return;
+      if (!flushing) flushing = flushPending().finally(() => { flushing = undefined; });
+      await flushing;
+    },
+    async recordWorkerBlocker(snapshot, reason) {
+      if (isWorkerBlocker({ ...snapshot, wait: { kind: "external", reason } })) {
+        await inbox.setMeta(`${workerPrefix}${targetKey(snapshot)}`, { revision, head: snapshot.pr?.head?.sha });
+      }
+    },
+    async recover() {
+      // Backfill results from older releases once, without an invocation or a synthetic webhook.
+      const snapshots = await inbox.waitsToEvaluate(true, true);
+      if (!initialized) {
+        for (const snapshot of snapshots) await inbox.transaction(tx => enqueueStatusResult(inbox, tx, snapshot));
+        initialized = true;
+      }
+      for (const snapshot of snapshots) {
+        if (!isWorkerBlocker(snapshot)) continue;
+        const key = `${workerPrefix}${targetKey(snapshot)}`;
+        const observed = await inbox.meta(key);
+        const head = snapshot.pr?.head?.sha;
+        if (observed?.revision === revision && observed.head === head) continue;
+        if (await inbox.wake(snapshot, digest(["worker-release", revision, head]), { recovery: true })) {
+          await inbox.setMeta(key, { revision, head });
+          event("babysitter.worker.recovery.woken", { repository: snapshot.repository, pull_request: snapshot.number, head_sha: head, revision });
+        }
+      }
+    }
+  };
+}
