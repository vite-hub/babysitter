+                }
+            }
+            else
+                throw new Error(`Classic protection unavailable (HTTP ${classic.status})`);
+            return { ...base, status: 'known', classicSource, required: [...new Map(required.map(item => [`${item.context}\0${item.appId ?? '*'}`, item])).values()] };
