+const record = (value) => value && typeof value === 'object' && !Array.isArray(value) ? value : undefined;
+const appId = (value) => {
+    if (value === undefined || value === null || value === -1)
+        return null;
+    if (typeof value !== 'number' || !Number.isInteger(value) || value < 0)
+        throw new Error('Invalid required-check integration ID');
+    return value;
+};
+function check(value, source) {
+    const item = record(value);
+    if (!item || typeof item.context !== 'string' || !item.context.trim())
+        throw new Error('Incomplete required-check context');
+    return { context: item.context, appId: appId(source === 'rule' ? item.integration_id : item.app_id) };
+}
+function rulesChecks(data) {
+    if (!Array.isArray(data))
+        throw new Error('Incomplete active branch rules response');
+    return data.flatMap(value => {
+        const rule = record(value);
+        if (!rule || typeof rule.type !== 'string')
+            throw new Error('Incomplete active branch rule');
+        if (rule.type === 'workflows' || rule.type === 'required_workflows')
+            throw new Error('Required workflow rules cannot be reduced to check contexts');
+        if (rule.type !== 'required_status_checks')
+            return [];
+        if (!Array.isArray(rule.parameters?.required_status_checks))
+            throw new Error('Incomplete ruleset required-check parameters');
+        return rule.parameters.required_status_checks.map((item) => check(item, 'rule'));
+    });
+}
+function classicChecks(data) {
+    const policy = record(data);
+    if (!policy || !Array.isArray(policy.contexts) || policy.checks !== undefined && !Array.isArray(policy.checks))
+        throw new Error('Incomplete classic status-check protection');
+    const bound = (policy.checks ?? []).map((item) => check(item, 'classic'));
+    for (const context of policy.contexts) {
+        if (typeof context !== 'string' || !context.trim())
+            throw new Error('Incomplete classic required-check context');
+        // contexts repeats the check names but loses their app binding.
+        if (!bound.some(item => item.context === context))
+            bound.push({ context, appId: null });
+    }
+    return bound;
+}
+/** Cache authoritative policy, including explicit unknown results; never infer CI requirements from names. */
+export function createRequiredPolicyReader(read, options = {}) {
+    const clock = options.clock ?? Date.now;
+    const cache = new Map();
+    const active = new Map();
+    const request = async (path, signal) => { try {
+        signal?.throwIfAborted();
+        return await read(path, signal);
+    }
+    catch {
+        signal?.throwIfAborted();
+        return { status: 0 };
+    } };
