+                    if (branch?.protected !== true || branch.protection?.enabled !== true || !summary
+                        || !Array.isArray(summary.contexts) || !Array.isArray(summary.checks)
+                        || !['everyone', 'non_admins', 'off'].includes(summary.enforcement_level))
+                        throw new Error('Classic protection response is ambiguous; branch summary is incomplete');
+                    if (summary.enforcement_level === 'off' && (summary.contexts.length || summary.checks.length))
+                        throw new Error('Disabled status-check summary contains ambiguous requirements');
+                    if (summary.contexts.some((context) => !summary.checks.some((item) => item?.context === context)))
+                        throw new Error('Branch summary omits required-check integration bindings');
