--- /dev/null
+++ b/dist/presets/babysitter/provider-head.js
@@ -0,0 +1,12 @@
+/** Prefer live Git proof while a pass can still create and push another commit. */
+export async function readProviderHead(directory, pushedHead, readGitHead) {
+    if (directory) {
+        try {
+            const head = await readGitHead(directory);
+            if (head) return head;
+        } catch (error) {
+            if (!pushedHead()) throw error;
+        }
+    }
+    return pushedHead();
+}
