{
  "name": "babysitter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1 --port 3028",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "evlog": "^2.29.0",
    "h3": "^2.0.1-rc.25",
    "nitro": "3.0.260429-beta",
    "posthog-node": "^5.52.1",
    "vite": "^8.2.2",
    "vite-hub": "https://pkg.pr.new/vite-hub/vitehub/vite-hub@2ba936d2a33701499ef1c8607ab9631373c405c1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "imports": {
    "#vitehub/env/public": {
      "types": "./.vitehub/env/public.d.ts",
      "default": "./.vitehub/env/public.mjs"
    },
    "#vitehub/env/server": {
      "types": "./.vitehub/env/server.d.ts",
      "default": "./.vitehub/env/server.mjs"
    }
  }
}
